<UserControl x:Class="DependencyGraph.UI.DependencyGraphControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="1000">
    <!--
        Colours are applied in code (ApplyTheme), not by DynamicResource on the shell's brush
        keys: those keys are not in this element's resource tree, so the lookup silently finds
        nothing and the text keeps whatever WPF's default chrome gives it.
    -->
    <UserControl.Resources>
        <Style x:Key="BarLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,5,0"/>
        </Style>
        <Style x:Key="BarCombo" TargetType="ComboBox">
            <Setter Property="Height" Value="23"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="BarButton" TargetType="Button">
            <Setter Property="Height" Value="23"/>
            <Setter Property="Padding" Value="9,0"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
        </Style>
    </UserControl.Resources>

    <!--
        ToolTipService's timings are inheritable, so setting them here covers the command bar and
        the graph surface. The default five seconds is not enough for tooltips that explain what a
        control is for, and the default half-second delay makes them fire while the pointer is
        only passing over the bar.
    -->
    <Grid ToolTipService.InitialShowDelay="450"
          ToolTipService.ShowDuration="60000"
          ToolTipService.BetweenShowDelay="200">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!--
            Command bar. A plain Grid rather than a ToolBar inside a ToolBarTray: ToolBar draws a
            drag grip and an overflow chevron from its own control template, so they keep WPF's
            default look (including a yellow hover highlight) however the rest of the bar is
            themed, and OverflowMode.Never does not remove the chevron. It also restyles every
            child it hosts. Laying the bar out directly avoids all of that.

            What to show sits on the left, actions on the right, so the controls you change most
            stay put as the window is resized.
        -->
        <Border x:Name="CommandBar" Grid.Row="0" Padding="8,5" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*" MinWidth="8"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="Lbl_Project" Text="Project" Style="{StaticResource BarLabel}"/>
                    <ComboBox x:Name="CBProjectNames"
                              Style="{StaticResource BarCombo}"
                              Width="220"
                              IsEditable="True"
                              IsTextSearchEnabled="True"
                              StaysOpenOnEdit="True"
                              ToolTip="Which project the graph is drawn from.&#10;Type to search. Two projects sharing a name show their paths."/>

                    <TextBlock x:Name="Lbl_Show" Text="Show" Style="{StaticResource BarLabel}"/>
                    <ComboBox x:Name="CBDisplayMethod"
                              Style="{StaticResource BarCombo}"
                              Width="175"
                              ToolTip="Which references become arrows.&#10;&#10;Deepest references only  -  one arrow per project, giving a clean tree&#10;All references  -  every reference of every project, the honest picture&#10;Project references only  -  this project and what it references directly&#10;Referenced by (impact)  -  everything that depends on this project"/>

                    <TextBlock x:Name="Lbl_Direction" Text="Direction" Style="{StaticResource BarLabel}"/>
                    <ComboBox x:Name="CBOrientation"
                              Style="{StaticResource BarCombo}"
                              Width="120"
                              ToolTip="Which way the graph grows as references get deeper."/>

                    <TextBlock x:Name="Lbl_Depth" Text="Depth" Style="{StaticResource BarLabel}"/>
                    <ComboBox x:Name="CBDepth"
                              Style="{StaticResource BarCombo}"
                              Width="70"
                              Margin="0"
                              ToolTip="How many levels of references to draw.&#10;&#10;All follows them to the end. A number stops after that many levels, cutting&#10;whole levels cleanly - you never get an arrow pointing at a project that was&#10;left out. Worth limiting on a large solution."/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="Btn_ZoomFit" Style="{StaticResource BarButton}"
                            ToolTip="Zoom so the whole graph fits the window.&#10;It opens at 100% instead, which keeps the labels crisp.">Fit</Button>
                    <Button x:Name="Btn_Refresh" Style="{StaticResource BarButton}"
                            ToolTip="Rescan the solution.&#10;Adding or removing a project is picked up on its own; use this after editing&#10;a project's references outside the IDE.">Refresh</Button>

                    <ToggleButton x:Name="Btn_Focus" Height="23" Padding="9,0" Margin="0,0,4,0"
                                  ToolTip="Narrow the graph to the projects you have picked.&#10;&#10;Ctrl+click two or more nodes, then switch this on: everything else is dropped&#10;and you are left with just those projects and the references between them.&#10;For getting a readable answer out of a solution with hundreds of projects.&#10;&#10;Only references directly between the projects you picked are drawn. If one&#10;reaches another through a project you did not pick, there is no arrow.&#10;&#10;Switch off to get the whole graph back.">Focus</ToggleButton>

                    <ToggleButton x:Name="Btn_Group" Height="23" Padding="9,0" Margin="0,0,4,0"
                                  ToolTip="Draw a box around the projects in each solution folder, named after it.&#10;&#10;Click the chevron beside a folder name to collapse that folder to a single&#10;node, with its references gathered onto it; click that node to expand it again.">Group</ToggleButton>

                    <ToggleButton x:Name="Btn_Legend" Height="23" Padding="9,0" Margin="0,0,4,0"
                                  ToolTip="Show what the colours and arrows mean.">Legend</ToggleButton>

                    <Border x:Name="BarSeparator" Width="1" Margin="5,3" SnapsToDevicePixels="True"/>

                    <Button x:Name="Btn_SaveAs" Style="{StaticResource BarButton}"
                            ToolTip="Save the graph on screen.&#10;&#10;PNG captures the whole graph, not just the part in view. DGML opens in Visual&#10;Studio's own graph editor. Graphviz DOT is plain text; SVG and PNG through&#10;Graphviz are offered when dot.exe can be found.">Save As...</Button>
                    <Button x:Name="Btn_SaveSolutionDGML" Style="{StaticResource BarButton}" Margin="0"
                            ToolTip="Save every project in the solution and its references - not just the graph on&#10;screen - as DGML or Graphviz.">Save Solution Graph...</Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- GraphViewer.BindToPanel needs a Panel, so this host is a Grid, not a Border. -->
        <Grid x:Name="GraphHost" Grid.Row="1" ClipToBounds="True"/>

        <!-- Legend, overlaid on the graph so it costs no layout space when hidden. -->
        <Border x:Name="LegendPanel"
                Grid.Row="1"
                Visibility="Collapsed"
                HorizontalAlignment="Right" VerticalAlignment="Top"
                Margin="0,10,14,0" Padding="10,8"
                BorderThickness="1" CornerRadius="3">
            <StackPanel x:Name="LegendItems"/>
        </Border>

        <TextBlock x:Name="EmptyMessage"
                   Grid.Row="1"
                   Visibility="Collapsed"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   TextAlignment="Center" TextWrapping="Wrap"
                   MaxWidth="420" Opacity="0.75"/>

        <Border x:Name="StatusBarMain" Grid.Row="2" Padding="8,3" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock x:Name="SB_ProjectName" Text="" Margin="0,0,14,0"/>
                    <TextBlock x:Name="SB_Nodes" Text="" Margin="0,0,14,0"/>
                    <TextBlock x:Name="SB_Connections" Text="" Margin="0,0,14,0"/>
                    <TextBlock x:Name="SB_Zoom" Text="" Margin="0,0,14,0"/>
                    <TextBlock x:Name="SB_Selection" Text=""/>
                </StackPanel>
                <TextBlock x:Name="SB_ProjectsCount" Grid.Column="2" Text=""/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
