<?xml version="1.0" encoding="utf-8"?>
<PackageManifest Version="2.0.0" xmlns="http://schemas.microsoft.com/developer/vsx-schema/2011" xmlns:d="http://schemas.microsoft.com/developer/vsx-schema-design/2011">
    <Metadata>
        <Identity Id="DependencyGraph.b16f35c3-ecb1-4300-82b8-c04a14f874cb" Version="2026.1.0.0" Language="en-US" Publisher="Lokesh Govindu" />
        <DisplayName>DependencyGraph</DisplayName>
        <Description xml:space="preserve">Draws your solution's project reference graph in a dockable tool window, in any edition of Visual Studio - Code Map needs Enterprise. Five views, including what depends on a project and the whole solution at once; boxes per solution folder that collapse to one node; drag anything where you want it. Exports to PNG, DGML and Graphviz. Nothing to install: Graphviz is only needed for its own SVG/PNG export.</Description>
        <MoreInfo>https://marketplace.visualstudio.com/items?itemName=LokeshGovindu.DependencyGraph</MoreInfo>
        <ReleaseNotes>https://github.com/lokeshgovindu/DependencyGraph/releases</ReleaseNotes>
        <Icon>Resources\Icon.png</Icon>
        <PreviewImage>Resources\PreviewImage.png</PreviewImage>
        <Tags>dependency graph, project references, dependencies, solution, visualization, diagram, architecture, code map, dgml, graphviz, refactoring, build</Tags>
    </Metadata>
    <Installation>
        <InstallationTarget Id="Microsoft.VisualStudio.Community" Version="[17.0, 19.0)">
            <ProductArchitecture>amd64</ProductArchitecture>
        </InstallationTarget>
    </Installation>
    <Prerequisites>
        <Prerequisite Id="Microsoft.VisualStudio.Component.CoreEditor" Version="[17.0,)" DisplayName="Visual Studio core editor" />
    </Prerequisites>
    <Assets>
        <Asset Type="Microsoft.VisualStudio.VsPackage" d:Source="Project" d:ProjectName="%CurrentProject%" Path="|%CurrentProject%;PkgdefProjectOutputGroup|" />
    </Assets>
</PackageManifest>
